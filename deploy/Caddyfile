{
    email admin@respulse.online
}

www.respulse.online {
    redir https://respulse.online{uri} permanent
}

mail.respulse.online {
    respond "ResPulse Mail Server Gateway" 200
}

grafana.respulse.online {
    reverse_proxy grafana:3000
}

respulse.online {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        # Same-origin app; the avatar hosts are the only exceptions (WayForPay checkout is a full-page redirect).
        # style-src needs 'unsafe-inline' for the inline style attributes of Radix UI and Recharts.
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://api.dicebear.com https://images.unsplash.com; font-src 'self' data:; connect-src 'self' wss://respulse.online; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
        -Server
    }

    # REST API, WebSockets, health checks, metrics, badges -> backend (unbuffered)
    @backend path /api/* /ws* /health* /metrics* /badge*
    handle @backend {
        reverse_proxy respulse-backend:8080 {
            flush_interval -1
        }
    }

    # Frontend SPA
    handle {
        reverse_proxy respulse-frontend:8080
    }

    log {
        output stdout
        format json
    }
}
