POSTGRES_USER=respulse
POSTGRES_PASSWORD=change_this_to_a_strong_password
POSTGRES_DB=respulse

# Required: signs session tokens. Generate with: openssl rand -hex 32
JWT_SECRET=change_this_to_a_random_64_char_hex_string
# Allow probes and webhooks to reach private/loopback/link-local addresses (SSRF guard off). Keep false on a public deployment.
ALLOW_PRIVATE_TARGETS=false
# Free open beta: keep false to hide prices and checkout.
BILLING_ENABLED=false
# Comma-separated emails allowed to open the operator report (/admin).
ADMIN_EMAILS=
# WayForPay merchant credentials (from WayForPay merchant portal)
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_SECRET_KEY=
WAYFORPAY_MERCHANT_PASSWORD=
WAYFORPAY_MERCHANT_DOMAIN=respulse.online
WAYFORPAY_CURRENCY=USD

# HMAC secret from FastSpring (Webhooks -> HMAC SHA256 Secret); webhooks are rejected without it.
FASTSPRING_WEBHOOK_SECRET=
FASTSPRING_LIVE_MODE=false

# Image tag to run (git short SHA); `make deploy` rewrites it on the server.
IMAGE_TAG=latest
# Image registry namespace the images are pulled from.
REGISTRY=ghcr.io/andrewchuev

# Email confirmation for new signups (needs SMTP below). Leave false until SMTP works.
REQUIRE_EMAIL_VERIFICATION=false
# Any SMTP provider works. SMTP_TLS: starttls (port 587, default), tls (implicit TLS, port 465) or none (local test servers only).
SMTP_HOST=
SMTP_PORT=
SMTP_TLS=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=ResPulse <noreply@respulse.online>
