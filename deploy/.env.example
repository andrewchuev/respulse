POSTGRES_USER=respulse
POSTGRES_PASSWORD=change_this_to_a_strong_password
POSTGRES_DB=respulse

# Required: signs session tokens. Generate with: openssl rand -hex 32
JWT_SECRET=change_this_to_a_random_64_char_hex_string
# Passwordless demo personas and seeded demo passwords. Keep false in production.
DEMO_MODE=false
# HMAC secret from FastSpring (Webhooks -> HMAC SHA256 Secret); webhooks are rejected without it.
FASTSPRING_WEBHOOK_SECRET=
FASTSPRING_LIVE_MODE=false
